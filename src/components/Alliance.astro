---
import Section from "./Section.astro";
import { useTranslations } from "../i18n/utils";

const t = useTranslations(Astro.currentLocale).alliance;

// Same-domain paths. They are a Vercel rewrite to the partner store deployment
// (Spanish only, so they are intentionally not locale-prefixed), not Astro
// routes, so they 404 under `astro dev`.
const storeHref = "/tienda";

// Inline 24x24 stroke icon bodies (Tabler style). Kept here so the section
// stays self-contained; they inherit color through `currentColor`.
const icons = {
  desktop:
    '<path d="M3 5a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1v-10z" /><path d="M7 20h10" /><path d="M9 16v4" /><path d="M15 16v4" />',
  cpu: '<path d="M5 5m0 1a1 1 0 0 1 1 -1h12a1 1 0 0 1 1 1v12a1 1 0 0 1 -1 1h-12a1 1 0 0 1 -1 -1z" /><path d="M9 9h6v6h-6z" /><path d="M3 10h2" /><path d="M3 14h2" /><path d="M10 3v2" /><path d="M14 3v2" /><path d="M21 10h-2" /><path d="M21 14h-2" /><path d="M10 21v-2" /><path d="M14 21v-2" />',
  mouse:
    '<path d="M6 3m0 4a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-4a4 4 0 0 1 -4 -4z" /><path d="M12 7l0 4" />',
  quote:
    '<path d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2" /><path d="M9 3m0 2a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v0a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2z" /><path d="M9 12l.01 0" /><path d="M13 12l2 0" /><path d="M9 16l.01 0" /><path d="M13 16l2 0" />',
  shield:
    '<path d="M11.46 20.846a12 12 0 0 1 -7.96 -14.846a12 12 0 0 0 8.5 -3a12 12 0 0 0 8.5 3a12 12 0 0 1 -.09 7.06" /><path d="M15 19l2 2l4 -4" />',
  arrow: '<path d="M5 12l14 0" /><path d="M13 18l6 -6" /><path d="M13 6l6 6" />',
};

// Zipped by index with `t.cards` (the localized title and description).
const shortcuts = [
  { href: "/tienda/categorias/pc-gamer", icon: icons.desktop },
  { href: "/tienda/categorias/componentes", icon: icons.cpu },
  { href: "/tienda/categorias/perifericos", icon: icons.mouse },
  { href: "/tienda/armar-tu-pc", icon: icons.quote },
];
const cards = t.cards.map((card, i) => ({ ...card, ...shortcuts[i] }));
---

<Section id="alliance" styles="grid gap-2 text-center relative">
  <!-- Decorative blobs -->
  <div class="absolute -left-40 -top-20 w-80 h-80 bg-primary/5 dark:bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -right-32 bottom-0 w-64 h-64 bg-primary/5 dark:bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>

  <h4 data-reveal class="text-primary text-lg font-semibold">{t.tag}</h4>
  <!-- data-split-text wraps every character in an inline-block, so a long title would
       break mid-word on phones: the size scales down to always fit on one line. -->
  <h3 data-split-text class="whitespace-nowrap leading-none text-[length:min(3rem,calc((80vw_-_2rem)/10))] font-bold text-gradient">{t.title}</h3>
  <p data-reveal class="text-balance max-w-[640px] mx-auto text-slate-500 dark:text-slate-400" style="transition-delay: 200ms;">
    {t.description}
  </p>

  <div
    data-reveal
    class="relative mx-auto mt-12 w-full max-w-md rounded-2xl bg-white px-8 pb-7 pt-9 shadow-lg ring-1 ring-slate-900/5 dark:bg-slate-100 dark:ring-0 dark:shadow-primary/30"
  >
    <span class="absolute -top-3.5 left-1/2 inline-flex -translate-x-1/2 items-center gap-1.5 whitespace-nowrap rounded-full bg-primary px-4 py-1 text-xs font-semibold text-white">
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={icons.shield}
      />
      {t.badge}
    </span>
    <img
      src="/company-logos/gsp-logo.png"
      alt={t.logoAlt}
      width="640"
      height="164"
      loading="lazy"
      decoding="async"
      class="gsp-logo mx-auto h-16 w-auto sm:h-20"
    />
  </div>

  <div
    data-reveal-stagger
    class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4"
  >
    {
      cards.map(({ href, icon, title, description }) => (
        <a
          href={href}
          data-reveal
          data-spotlight
          class="group relative flex flex-col items-center gap-2 overflow-hidden rounded-xl bg-white p-6 py-8 text-center shadow-lg transition-all duration-300 hover:-translate-y-2 hover:bg-primary hover:shadow-xl hover:shadow-primary/25 focus-visible:-translate-y-2 focus-visible:bg-primary focus-visible:shadow-xl focus-visible:shadow-primary/25 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary dark:bg-primary/5 dark:shadow-primary/40 dark:hover:bg-primary dark:focus-visible:bg-primary"
        >
          <div class="relative z-10 max-w-max rounded-full bg-primary p-3 text-white transition-all duration-300 group-hover:scale-110 group-hover:bg-white group-hover:text-primary group-focus-visible:scale-110 group-focus-visible:bg-white group-focus-visible:text-primary">
            <svg
              class="size-[35px]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icon}
            />
          </div>
          <h5 class="relative z-10 text-lg font-bold transition-colors group-hover:text-white group-focus-visible:text-white dark:text-white">
            {title}
          </h5>
          <p class="relative z-10 text-sm text-slate-500 transition-colors group-hover:text-white group-focus-visible:text-white dark:text-slate-300">
            {description}
          </p>
          <span class="relative z-10 mt-auto inline-flex items-center gap-1 pt-3 text-sm font-semibold text-primary transition-colors group-hover:text-white group-focus-visible:text-white dark:text-blue-300">
            {t.cardCta}
            <svg
              class="size-4 transition-transform duration-300 group-hover:translate-x-1 group-focus-visible:translate-x-1"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icons.arrow}
            />
          </span>
          <div class="size-28 absolute bg-transparent group-hover:bg-white group-focus-visible:bg-white transition-colors right-0 top-0 rounded-full translate-x-1/2 -translate-y-1/2 opacity-10" />
          <div class="size-48 absolute bg-transparent group-hover:bg-white group-focus-visible:bg-white transition-colors right-0 top-0 rounded-full translate-x-1/4 -translate-y-1/2 opacity-5" />
        </a>
      ))
    }
  </div>

  <div data-reveal class="mt-12 grid justify-items-center gap-4">
    <a
      href={storeHref}
      class="btn-primary inline-flex items-center gap-2 rounded-full bg-primary px-6 py-2.5 text-sm font-semibold text-white transition-all hover:bg-primary/90 hover:shadow-md"
    >
      {t.cta}
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={icons.arrow}
      />
    </a>
    <p class="max-w-md text-balance text-xs text-slate-500 dark:text-slate-400">{t.note}</p>
  </div>
</Section>
